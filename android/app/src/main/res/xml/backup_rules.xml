<?xml version="1.0" encoding="utf-8"?>
<!--
  Android backup is OFF (allowBackup="false" in the manifest): nothing is
  copied to Google Drive. Use Settings > Back up data to save a backup file
  yourself. Excluding everything here as well is a second safety net.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
